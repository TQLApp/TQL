<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Plain net8.0, not Tql.targets' net8.0-windows, so the tests run on Linux. It
		compiles the YouTrack plugin's files that have no WPF or TQL dependencies
		instead of referencing the plugin.
	-->
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12.0</LangVersion>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
		<PackageReference Include="NUnit" Version="3.14.0" />
		<PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\src\Tql.Plugins.YouTrack\Services\YouTrackClient.cs" Link="Plugin\Services\YouTrackClient.cs" />
		<Compile Include="..\..\src\Tql.Plugins.YouTrack\Services\YouTrackDtos.cs" Link="Plugin\Services\YouTrackDtos.cs" />
		<Compile Include="..\..\src\Tql.Plugins.YouTrack\Support\YouTrackUrls.cs" Link="Plugin\Support\YouTrackUrls.cs" />
		<Compile Include="..\..\src\Tql.Plugins.YouTrack\Support\YouTrackQueries.cs" Link="Plugin\Support\YouTrackQueries.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- Responses captured from a YouTrack 2026.2 server, anonymised. -->
		<EmbeddedResource Include="Fixtures\*" LogicalName="Fixtures.%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
