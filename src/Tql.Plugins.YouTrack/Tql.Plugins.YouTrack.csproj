<Project Sdk="Microsoft.NET.Sdk">


	<Import Project="..\..\TqlPluginPackage.targets" />

	<PropertyGroup>
		<Product>TQL YouTrack Plugin</Product>
		<Description>Techie's Quick Launcher plugin for YouTrack by JetBrains.</Description>
		<PackageId>TQLApp.Plugins.YouTrack</PackageId>
		<PackageProjectUrl>https://github.com/TQLApp/TQL/wiki/YouTrack-plugin</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\**\*" />
		<None Remove="Resources\**\*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Tql.Utilities\Tql.Utilities.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="ConfigurationUI\ConfigurationControl.xaml.cs">
			<SubType>Code</SubType>
		</Compile>
		<Compile Update="ConfigurationUI\ConnectionEditWindow.xaml.cs">
			<SubType>Code</SubType>
		</Compile>
		<Compile Update="Labels.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Labels.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Labels.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Labels.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>